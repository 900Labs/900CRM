{
  "name": "900crm",
  "private": true,
  "version": "0.9.0",
  "description": "Offline-first CRM for developing nations — 900 Labs open infrastructure initiative",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/900Labs/900CRM"
  },
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "apps/desktop"
  ],
  "scripts": {
    "dev": "npm --workspace apps/desktop run dev",
    "build": "npm --workspace apps/desktop run build",
    "preview": "npm --workspace apps/desktop run preview",
    "check": "node scripts/check-frontend.mjs",
    "check:tooling": "node scripts/verify-frontend-tooling.mjs",
    "check:release-guardrails": "node scripts/verify-public-release-guardrails.mjs",
    "check:watch": "npm --workspace apps/desktop run check:watch",
    "test": "node scripts/test-frontend.mjs",
    "pretest:e2e": "npm --workspace apps/desktop exec svelte-kit sync",
    "test:e2e": "playwright test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "release:preflight:local": "node scripts/run-release-preflight.mjs",
    "release:macos:dmg:headless": "node scripts/build-macos-dmg-headless.mjs",
    "release:macos:smoke:local": "node scripts/run-local-macos-package-smoke.mjs",
    "release:notes": "node scripts/generate-release-notes.mjs",
    "release:notes:sample": "node scripts/generate-release-notes.mjs --out dist/release-sample/release-notes.md --release-version 0.0.0-sample --release-title \"900CRM sample release\"",
    "release:manifest": "node scripts/generate-release-manifest.mjs",
    "release:manifest:sample": "node scripts/generate-release-manifest.mjs --sample --out-dir dist/release-sample --platform local --release-version 0.0.0-sample --release-title \"900CRM sample release\" --release-ref local --release-sha local --generated-at 2026-06-24T00:00:00.000Z",
    "release:artifacts:verify": "node scripts/verify-release-artifacts.mjs",
    "release:artifacts:verify:sample": "node scripts/verify-release-artifacts.mjs --sample",
    "tauri": "npm --workspace apps/desktop run tauri"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1"
  }
}
